{
  "name": "contour-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./tests/native-fetch.ts --test --test-concurrency=1 tests/*.test.ts",
    "build": "tsc --noEmit && vite build",
    "test:smoke": "node --experimental-strip-types tests/container-smoke.mjs"
  },
  "dependencies": {
    "manifold-3d": "3.5.3",
    "three": "0.186.0",
    "tweakpane": "4.0.5"
  },
  "devDependencies": {
    "@tweakpane/core": "2.0.5",
    "@types/node": "26.6.2",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "license": "GPL-3.0-or-later"
}
